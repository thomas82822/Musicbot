# ════════════════════════════════════════════════════════════════
# 4ST Music Bot — Environment Variables
# ════════════════════════════════════════════════════════════════
# Is file ko copy karo: cp .env.example .env
# Phir apni values fill karo
# KABHI BHI .env file GitHub pe push mat karo!
# ════════════════════════════════════════════════════════════════


# ── REQUIRED ────────────────────────────────────────────────────

# Telegram API credentials — https://my.telegram.org
API_ID=
API_HASH=

# Bot token — @BotFather se lelo
BOT_TOKEN=

# Userbot session string — python SESSION_STRING_HELPER.py chalao
SESSION_STRING=

# Tera Telegram user ID — @userinfobot se pata karo
OWNER_ID=


# ── RECOMMENDED ─────────────────────────────────────────────────

# Log channel ID (negative number, e.g. -1001234567890)
LOG_CHANNEL=

# Support group link
SUPPORT_CHAT=https://t.me/YourSupportGroup

# Tera Telegram username (@ ke bina)
OWNER_USERNAME=YourUsername

# Bot ka naam (owner panel se bhi change kar sakte ho)
BOT_NAME=🎵 4ST Music Bot

# Bot version string
BOT_VERSION=v1.0

# Force users to join this channel before using bot (optional)
# MUST_JOIN=https://t.me/YourChannel


# ── DATA SYNC (GitHub) ───────────────────────────────────────────
# Bot restart ke baad bhi data save rehne ke liye

# GitHub Personal Access Token (repo scope)
GITHUB_TOKEN=

# GitHub repo — format: username/reponame
BOT_REPO=thomasvipxd/Musicbot


# ── LIMITS (Optional, defaults shown) ───────────────────────────

# Max songs in queue per group
# MAX_QUEUE=10

# Download directory
# DOWNLOAD_DIR=downloads/

# Daily economy reward range
# DAILY_REWARD_MIN=500
# DAILY_REWARD_MAX=5000
