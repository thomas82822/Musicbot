{
  "name": "4st Music Bot",
  "description": "Fast Telegram music bot with YouTube streaming and group management.",
  "keywords": [
    "telegram",
    "bot",
    "music",
    "python",
    "youtube"
  ],
  "website": "https://t.me/ApexAssociation",
  "stack": "heroku-26",
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "Standard-2X"
    }
  },
  "env": {
    "API_ID": {
      "description": "Telegram App ID — my.telegram.org → API Development Tools",
      "required": true,
      "value": ""
    },
    "API_HASH": {
      "description": "Telegram App Hash — my.telegram.org → API Development Tools",
      "required": true,
      "value": ""
    },
    "BOT_TOKEN": {
      "description": "Bot Token — @BotFather on Telegram",
      "required": true,
      "value": ""
    },
    "SESSION_STRING": {
      "description": "Pyrogram session string for the assistant/userbot account. Generate via SESSION_STRING_HELPER.py or @StringFatherBot.",
      "required": false,
      "value": ""
    },
    "OWNER_ID": {
      "description": "Your Telegram numeric user ID — message @userinfobot",
      "required": true,
      "value": ""
    },
    "OWNER_USERNAME": {
      "description": "Your Telegram username without @",
      "required": false,
      "value": ""
    },
    "LOG_CHANNEL": {
      "description": "Log channel ID (e.g. -1001234567890). Add bot as admin with post rights.",
      "required": false,
      "value": ""
    },
    "MUST_JOIN": {
      "description": "Channel username (no @) users must join to use the bot. Leave empty to disable.",
      "required": false,
      "value": ""
    },
    "SUPPORT_CHAT": {
      "description": "Support group invite link shown in /start",
      "value": "",
      "required": false
    },
    "GITHUB_TOKEN": {
      "description": "GitHub personal access token with repo write scope — for data persistence across restarts.",
      "required": false,
      "value": ""
    },
    "BOT_REPO": {
      "description": "GitHub repo for data sync, e.g. thomasir/4st_music.",
      "value": "thomas91929/Musicbot",
      "required": false
    },
    "YOUTUBE_COOKIES": {
      "description": "YouTube cookies in Netscape format (base64-encoded).",
      "required": false,
      "value": ""
    },
    "VOLUME_BOOST": {
      "description": "Default volume multiplier (0.01–2.0). Default 1.5 = 150%.",
      "value": "1.5",
      "required": false
    },
    "MUSIC_ARCHIVE_CHANNEL": {
      "description": "Telegram channel ID for media cache. Add bot as admin with post rights.",
      "required": false,
      "value": ""
    },
    "MAX_QUEUE_SIZE": {
      "description": "Maximum songs a group can queue at once.",
      "value": "50",
      "required": false
    },
    "GEMINI_API_KEY": {
      "description": "Google Gemini API key for AI chatbot. Get at: aistudio.google.com/apikey",
      "required": false,
      "value": ""
    },
    "SPOTIFY_CLIENT_ID": {
      "description": "Spotify Client ID for Spotify support. Get at: developer.spotify.com/dashboard",
      "required": false,
      "value": ""
    },
    "SPOTIFY_CLIENT_SECRET": {
      "description": "Spotify Client Secret.",
      "required": false,
      "value": ""
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-apt"
    },
    {
      "url": "heroku/python"
    }
  ]
}
